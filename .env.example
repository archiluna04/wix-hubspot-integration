# Public HTTPS URL where this server is reachable (no trailing slash).
# Locally, expose the port with a tunnel (e.g. `ngrok http 3000`) and paste the HTTPS URL here.
APP_BASE_URL=https://your-app.example.com
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# SQLite file for mappings, contact links, sync log and job queue (no secrets are stored in plain text).
DATABASE_PATH=./data/app.db

# Signs dashboard session tokens and OAuth state. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Wix app (Wix Dev Center -> your app) ---
WIX_APP_ID=
WIX_APP_SECRET=
# Dev Center -> Webhooks -> "Public key". Paste as one line with \n for line breaks.
WIX_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- HubSpot public app (developers.hubspot.com -> Apps) ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# --- Token storage ---
# local: AES-256-GCM encrypted at rest in SQLite (key below). gcp: Google Cloud Secret Manager.
SECRET_STORE=local
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Required when SECRET_STORE=gcp (uses Application Default Credentials).
GCP_PROJECT_ID=

# Local-only: enables /dashboard?dev=1 without a signed Wix instance. Refused when NODE_ENV=production.
DEV_LOGIN_ENABLED=false

{
  "name": "wix-hubspot-integration",
  "version": "1.0.0",
  "description": "Self-hosted Wix app: HubSpot OAuth connection, bi-directional contact sync and Wix Forms lead capture with UTM attribution.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "hubspot:configure": "node scripts/configure-hubspot.mjs",
    "embed:snippet": "node scripts/embed-snippet.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.2.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@google-cloud/secret-manager": "^7.2.0"
  }
}

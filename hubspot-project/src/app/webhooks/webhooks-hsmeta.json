{
  "uid": "wix_hubspot_sync_webhooks",
  "type": "webhooks",
  "config": {
    "settings": {
      "targetUrl": "https://wix-hubspot-sync-archi.azurewebsites.net/webhooks/hubspot",
      "maxConcurrentRequests": 10
    },
    "subscriptions": {
      "legacyCrmObjects": [
        { "subscriptionType": "contact.creation", "active": true },
        { "subscriptionType": "contact.deletion", "active": true },
        { "subscriptionType": "contact.propertyChange", "propertyName": "email", "active": true },
        { "subscriptionType": "contact.propertyChange", "propertyName": "firstname", "active": true },
        { "subscriptionType": "contact.propertyChange", "propertyName": "lastname", "active": true },
        { "subscriptionType": "contact.propertyChange", "propertyName": "phone", "active": true },
        { "subscriptionType": "contact.propertyChange", "propertyName": "company", "active": true },
        { "subscriptionType": "contact.propertyChange", "propertyName": "jobtitle", "active": true }
      ]
    }
  }
}
